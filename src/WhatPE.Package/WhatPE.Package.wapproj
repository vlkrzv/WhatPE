<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0">
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props" Condition="'$(DesktopBridgePropsImported)' != 'true'" />
  <Import Project="Package.local.props" Condition="Exists('Package.local.props')" />
  <PropertyGroup>
    <LocalPackagePublisher Condition="'$(LocalPackagePublisher)' == ''">CN=WhatPE Dev</LocalPackagePublisher>
    <LocalPackagePublisherDisplayName Condition="'$(LocalPackagePublisherDisplayName)' == ''">WhatPE Dev</LocalPackagePublisherDisplayName>
  </PropertyGroup>
  <PropertyGroup>
    <ProjectGuid>{6F2C9F0C-9C7C-4C5E-9E44-2E7C7C0F3E9A}</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EntryPointProjectUniqueName>..\PeBinaryInfo\PeBinaryInfo.vcxproj</EntryPointProjectUniqueName>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>WhatPE.Package_TemporaryKey.pfx</PackageCertificateKeyFile>
    <PackageCertificateThumbprint>481A2F422D996BF6627E8A21396C27673E9CCE3D</PackageCertificateThumbprint>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>Disabled</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxPackageDir>AppPackages\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\Square44x44Logo.png" />
    <Content Include="Images\Square150x150Logo.png" />
    <Content Include="Images\StoreLogo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeBinaryInfo\PeBinaryInfo.vcxproj">
      <Project>{3ae382ef-714d-4a42-ab8f-b0d216f2c16a}</Project>
      <Name>PeBinaryInfo</Name>
    </ProjectReference>
    <ProjectReference Include="..\PeBinaryInfoExplorerCommand\PeBinaryInfoExplorerCommand.vcxproj">
      <Project>{691dd4c4-fda8-477a-9eaa-41d68c00a2f3}</Project>
      <Name>PeBinaryInfoExplorerCommand</Name>
    </ProjectReference>
  </ItemGroup>
  <!--
    Substitutes the real package Publisher identity (kept out of source control - see
    Package.local.props) into the finalized manifest right before it's packaged/signed. Runs after
    _ValidateAppxManifest (which validates the harmless placeholder text) and before
    _GenerateAppxPackageFile (which needs the real value to match the signing cert's Subject).
  -->
  <Target Name="_WhatPESubstitutePublisher" BeforeTargets="_GenerateAppxPackageFile">
    <PropertyGroup>
      <_WhatPEManifestContent>$([System.IO.File]::ReadAllText('$(FinalAppxManifestName)'))</_WhatPEManifestContent>
      <_WhatPEManifestContent>$(_WhatPEManifestContent.Replace('__WHATPE_LOCAL_PUBLISHER_DISPLAYNAME__', '$(LocalPackagePublisherDisplayName)'))</_WhatPEManifestContent>
      <_WhatPEManifestContent>$(_WhatPEManifestContent.Replace('__WHATPE_LOCAL_PUBLISHER__', '$(LocalPackagePublisher)'))</_WhatPEManifestContent>
    </PropertyGroup>
    <ItemGroup>
      <_WhatPEManifestLine Remove="@(_WhatPEManifestLine)" />
      <_WhatPEManifestLine Include="$(_WhatPEManifestContent)" />
    </ItemGroup>
    <WriteLinesToFile File="$(FinalAppxManifestName)" Lines="@(_WhatPEManifestLine)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" />
</Project>
